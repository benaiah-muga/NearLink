{
  "name": "nearlink",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/protocol"
  ],
  "scripts": {
    "predev": "npm run build:wasm",
    "dev": "npm run dev --workspace @nearlink/web",
    "prebuild": "npm run build:wasm",
    "build": "npm run build --workspace @nearlink/web",
    "build:wasm": "node scripts/build-protocol-wasm.mjs",
    "pretest:unit": "npm run build:wasm",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:compat": "npm run build && playwright test --project=firefox-smoke --project=webkit-smoke",
    "test:wasm": "node scripts/test-protocol-wasm.mjs",
    "verify:all": "node scripts/verify-foundation.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.4"
  }
}
