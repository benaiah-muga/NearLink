  {
    "name": "received message matching conflict and staged completion lifecycle",
    "operations": [
      {"kind":"request","value":{"version":1,"type":"sync_missing_request","room":"room1","syncId":"sync-1","requestId":"stage-1","sender":"device-a","targetSender":"device-b","messageIds":["alpha","beta"]},"expected":{"ok":true,"outcome":"accepted"}},
      {"kind":"observe_message","value":{"version":1,"type":"message","id":"alpha","room":"room1","sender":"device-b","senderName":"B","createdAt":"2026-10-14T12:00:00Z","body":"one"},"expected":{"ok":true,"outcome":"matched"}},
      {"kind":"observe_message","value":{"version":1,"type":"message","id":"alpha","room":"room1","sender":"device-b","senderName":"B","createdAt":"2026-10-14T12:00:00Z","body":"two"},"expected":{"ok":false,"code":"message_conflict"}},
      {"kind":"stage_completion","value":{"version":1,"type":"sync_page_complete","room":"room1","syncId":"sync-1","requestId":"stage-1","sender":"device-b","targetSender":"device-a","messageIds":[]},"expected":{"ok":false,"code":"invalid_sync_completion"}},
      {"kind":"stage_completion","value":{"version":1,"type":"sync_page_complete","room":"room1","syncId":"sync-1","requestId":"stage-1","sender":"device-b","targetSender":"device-a","messageIds":["alpha"]},"expected":{"ok":true,"outcome":"accepted","requestedIds":["alpha","beta"],"observedIds":["alpha"],"completedIds":["alpha"],"isCompleted":false}},
      {"kind":"observe_message","value":{"version":1,"type":"message","id":"alpha","room":"room1","sender":"device-b","senderName":"B","createdAt":"2026-10-14T12:00:00Z","body":"changed during storage verification"},"expected":{"ok":false,"code":"message_conflict"}},
      {"kind":"finish_completion","value":{"requestId":"stage-1","durable":false},"expected":{"ok":true}},
      {"kind":"stage_completion","value":{"version":1,"type":"sync_page_complete","room":"room1","syncId":"sync-1","requestId":"stage-1","sender":"device-b","targetSender":"device-a","messageIds":["alpha"]},"expected":{"ok":true,"outcome":"accepted","requestedIds":["alpha","beta"],"observedIds":["alpha"],"completedIds":["alpha"],"isCompleted":false}},
      {"kind":"finish_completion","value":{"requestId":"stage-1","durable":true},"expected":{"ok":true}},
      {"kind":"stage_completion","value":{"version":1,"type":"sync_page_complete","room":"room1","syncId":"sync-1","requestId":"stage-1","sender":"device-b","targetSender":"device-a","messageIds":["alpha"]},"expected":{"ok":true,"outcome":"duplicate","requestedIds":["alpha","beta"],"observedIds":[],"completedIds":["alpha"],"isCompleted":true}},
      {"kind":"reset_state","value":{},"expected":{"ok":true}},
      {"kind":"request","value":{"version":1,"type":"sync_missing_request","room":"room1","syncId":"sync-1","requestId":"stage-1","sender":"device-a","targetSender":"device-b","messageIds":["alpha","beta"]},"expected":{"ok":true,"outcome":"accepted"}}
    ]
