  {
    "name": "missing selection keeps peer order and excludes locally accepted IDs",
    "operations": [
      {"kind":"selector_start","value":{"peerIds":["a","b","c","d"]},"expected":{"ok":true}},
      {"kind":"selector_local","value":{"localIds":["b","d"]},"expected":{"ok":true}},
      {"kind":"selector_finish","value":{},"expected":{"ok":true,"missingIds":["a","c"]}}
    ]
  },
  {
    "name": "missing selection rejects an unsorted peer inventory",
    "operations": [
      {"kind":"selector_start","value":{"peerIds":["b","a"]},"expected":{"ok":false,"code":"invalid_identifier"}}
    ]
  },
  {
    "name": "empty selection returns no missing IDs",
    "operations": [
      {"kind":"selector_start","value":{"peerIds":[]},"expected":{"ok":true}},
      {"kind":"selector_local","value":{"localIds":[]},"expected":{"ok":true}},
      {"kind":"selector_finish","value":{},"expected":{"ok":true,"missingIds":[]}}
    ]
  },
  {
    "name": "duplicate local IDs are idempotent during missing selection",
    "operations": [
      {"kind":"selector_start","value":{"peerIds":["a","b","c"]},"expected":{"ok":true}},
      {"kind":"selector_local","value":{"localIds":["b","b"]},"expected":{"ok":true}},
      {"kind":"selector_local","value":{"localIds":["b"]},"expected":{"ok":true}},
      {"kind":"selector_finish","value":{},"expected":{"ok":true,"missingIds":["a","c"]}}
    ]
  },
